  <wpt lat="42.936117" lon="-2.317357">
    <ele>1097.6</ele>
    <time>2019-07-20T10:45:42Z</time>
    <name>Izquierda</name>
    <cmt>Giro a la izquierda en el cruce de caminos tomando la calzada romana. Seguir marcas blancas y rojas.</cmt>
    <desc>Giro a la izquierda en el cruce de caminos tomando la calzada romana. Seguir marcas blancas y rojas.</desc>
  </wpt>
