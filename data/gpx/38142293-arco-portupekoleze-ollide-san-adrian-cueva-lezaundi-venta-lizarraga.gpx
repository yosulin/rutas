  </wpt>
  <wpt lat="42.861757" lon="-2.047973">
    <ele>1096.6</ele>
    <time>2019-06-29T12:42:54Z</time>
    <name>Derecha para ir a Tximua</name>
    <cmt>Derecha para ir a Tximua</cmt>
