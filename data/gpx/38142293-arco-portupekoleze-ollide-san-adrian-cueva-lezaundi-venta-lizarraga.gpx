    <ele>1116.7</ele>
    <time>2019-06-29T11:53:10Z</time>
    <name>Izquierda</name>
    <cmt>Izquierda hacia pequeño sendero</cmt>
    <desc>Izquierda hacia pequeño sendero</desc>
  </wpt>
  <wpt lat="42.862071" lon="-2.066799">
    <ele>1103.0</ele>
    <time>2019-06-29T11:57:30Z</time>
